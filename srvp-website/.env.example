# Copy this file to ".env" and change the values. Never share or upload .env.
PORT=3000
ADMIN_USER=admin
# Use a long password nobody can guess (12+ characters, mix of letters/numbers/symbols)
ADMIN_PASSWORD=change-me
# Set to production when the site is live on HTTPS
NODE_ENV=development

# ---------------- ENQUIRY ALERTS ----------------
# Who gets alerted when a parent fills a form (comma-separate several)
NOTIFY_PHONE=
NOTIFY_EMAIL=

# Email (free). Gmail example: turn on 2-Step Verification, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Also send a "thank you" email to the parent when they give an email address
EMAIL_PARENT=false

# SMS (paid, about ₹5 per SMS on the Quick route). Sign up at fast2sms.com,
# add balance, copy the API key from the "Dev API" page. Leave blank to turn off.
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
